#!/usr/bin/env python3
"""
mythix-loader — Steamclient loader profile manager

Sets up non-invasive game loader profiles using mythix_loader.exe.
Does NOT modify game files — all loader files live in ~/.mythix/loader_profiles/.
Profiles launch games you own, through the real steamclient, with Steam running.

Usage:
    mythix-loader <game_dir> [--appid APPID] [--exe EXE] [--name NAME] [--dry-run] [--json] [--require-appid]
    mythix-loader --games [--all]
    mythix-loader --launch-info APPID
    mythix-loader --list
    mythix-loader --setup
    mythix-loader --help

Part of the Mythix toolkit.
"""

