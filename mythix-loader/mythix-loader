def _slug(text):
    """Lowercase, spaces to dashes, only a-z 0-9 - _ kept ("" if nothing is left)."""
    return re.sub(r"[^a-z0-9_-]", "", (text or "").lower().replace(" ", "-"))


# ── VDF / ACF parsing ──────────────────────────────────────────────────────
# Steam's libraryfolders.vdf and appmanifest_*.acf use the same text keyvalues
# format: quoted tokens, { } maps. Minimal, dependency-free parser.

def _vdf_tokens(text):
    i, n = 0, len(text)
    while i < n:
        c = text[i]
        if c in " \t\r\n":
            i += 1
            continue
        if c in "{}":
            yield c
            i += 1
            continue
        if c == "/" and i + 1 < n and text[i + 1] == "/":
            while i < n and text[i] != "\n":
                i += 1
            continue
        if c == '"':
            i += 1
            buf = []
            while i < n:
                c = text[i]
                if c == "\\" and i + 1 < n:
                    nxt = text[i + 1]
                    buf.append({"n": "\n", "t": "\t", "\\": "\\", '"': '"'}.get(nxt, nxt))
                    i += 2
                    continue
                if c == '"':
                    i += 1
                    break
                buf.append(c)
                i += 1
            yield ("str", "".join(buf))
            continue
        # bare token (uncommon in these files)
        j = i
        while j < n and text[j] not in ' \t\r\n{}"':
            j += 1
        yield ("str", text[i:j])
        i = j


def parse_vdf(text):
    toks = _vdf_tokens(text)

    def parse_map():
        d = {}
        for tok in toks:
            if tok == "}":
                return d
            if not isinstance(tok, tuple):
                continue
            key = tok[1]
            try:
                nxt = next(toks)
            except StopIteration:
                break
            if nxt == "{":
                d[key] = parse_map()
            elif isinstance(nxt, tuple):
                d[key] = nxt[1]
        return d

    try:
        first = next(toks)
    except StopIteration:
        return {}
    if first == "{":
        return parse_map()
    if not isinstance(first, tuple):
        return {}
    root = first[1]
    try:
        nxt = next(toks)
    except StopIteration:
        return {root: ""}
    if nxt == "{":
        return {root: parse_map()}
    return {root: nxt[1] if isinstance(nxt, tuple) else ""}


# ── Steam library discovery ──────────────────────────────────────────────────

def steam_library_entries(steam_dir):
    """Return [{path, apps:set(appid)}], steam_dir first, deduped by path.

    `apps` is the set of appids that library's entry in libraryfolders.vdf
    registers — i.e. which library Steam considers the real home of each app.
    Paths are deduped by their real location: ~/.steam/steam is usually a
    symlink to ~/.local/share/Steam, which libraryfolders.vdf lists again.
    The path is kept as libraryfolders.vdf spells it.
    """
    entries = []
    index = {}

    def add(p, apps, listed=False):
        p = os.path.normpath(p)
        key = os.path.realpath(p)
        if key in index:
            index[key]["apps"] |= set(apps)
            if listed:
                index[key]["path"] = p
            return
        e = {"path": p, "apps": set(apps)}
        index[key] = e
        entries.append(e)

    add(steam_dir, set())
    lf = os.path.join(steam_dir, "steamapps", "libraryfolders.vdf")
    if os.path.isfile(lf):
        try:
            with open(lf, encoding="utf-8", errors="replace") as f:
                data = parse_vdf(f.read())
            folders = data.get("libraryfolders") or data.get("LibraryFolders") or {}
            for key, val in folders.items():
                if isinstance(val, dict) and val.get("path"):
                    apps = val.get("apps")
                    add(val["path"], set(apps.keys()) if isinstance(apps, dict) else set(), listed=True)
                elif isinstance(val, str) and key.isdigit():  # legacy format
                    add(val, set(), listed=True)
        except Exception as e:
            warn(f"could not parse libraryfolders.vdf: {e}")
    return entries


def steam_libraries(steam_dir):
    """Library root paths (each contains a steamapps/), steam_dir first."""
    return [e["path"] for e in steam_library_entries(steam_dir)]


def installed_apps(steam_dir=None, dedup=True):
    """Enumerate installed apps across every library.

    Each entry: {appid, name, installdir (abs), library, state_flags,
    registered (listed in that library's apps map), manifest}. When the same
    appid has manifests in more than one library (e.g. an orphaned leftover),
    dedup keeps the best copy: registered in its library's apps map first,
    then one present on disk, then the higher StateFlags.
    """
    if steam_dir is None:
        steam_dir = find_steam_install()
    raw = []
    if not steam_dir:
        return raw
    for lib in steam_library_entries(steam_dir):
        sa = os.path.join(lib["path"], "steamapps")
        if not os.path.isdir(sa):
            continue
        try:
            entries = os.listdir(sa)
        except OSError:
            continue
        for fn in entries:
            if not (fn.startswith("appmanifest_") and fn.endswith(".acf")):
                continue
            path = os.path.join(sa, fn)
            try:
                with open(path, encoding="utf-8", errors="replace") as f:
                    st = (parse_vdf(f.read()).get("AppState") or {})
            except Exception:
                continue
            appid = str(st.get("appid") or fn[len("appmanifest_"):-len(".acf")])
            installdir = st.get("installdir", "")
            try:
                flags = int(st.get("StateFlags", "0"))
            except (TypeError, ValueError):
                flags = 0
            raw.append({
                "appid": appid,
                "name": st.get("name", ""),
                "installdir": os.path.join(sa, "common", installdir) if installdir else "",
                "library": lib["path"],
                "state_flags": flags,
                "registered": appid in lib["apps"],
                "manifest": path,
            })

    if dedup:
        def rank(a):
            present = bool(a["installdir"]) and os.path.isdir(a["installdir"])
            return (2 if a["registered"] else 0) + (1 if present else 0), a["state_flags"]
        best = {}
        for a in raw:
            if a["appid"] not in best or rank(a) > rank(best[a["appid"]]):
                best[a["appid"]] = a
        raw = list(best.values())

    raw.sort(key=lambda a: (a["name"] or "").lower())
    return raw


def is_tool_app(app):
    if app["appid"] in TOOL_APPIDS:
        return True
    name = (app["name"] or "").lower()
    return any(h in name for h in TOOL_NAME_HINTS)


def resolve_appid_from_library(game_dir, apps=None):
    """If game_dir maps to an installed app's directory, return (appid, name).

    Paths are compared with symlinks resolved, so ~/.steam/steam/... matches an
    install the library lists under ~/.local/share/Steam/... A folder above
    several installs (say steamapps/common) is ambiguous and matches nothing.
    """
    if apps is None:
        apps = installed_apps()
    target = os.path.realpath(game_dir)
    insts = [(os.path.realpath(a["installdir"]), a) for a in apps if a["installdir"]]
    # exact install-dir match first
    for inst, app in insts:
        if inst == target:
            return app["appid"], app["name"]
    # then a subfolder of an install (e.g. where the exe lives)
    for inst, app in insts:
        if target.startswith(inst + os.sep):
            return app["appid"], app["name"]
    # then a folder above an install, but only if exactly one install is below it
    below = [app for inst, app in insts if inst.startswith(target + os.sep)]
    if len(below) == 1:
        return below[0]["appid"], below[0]["name"]
    if below:
        warn(f"{game_dir} contains {len(below)} installed titles — pass the game's own folder")
    return None, None


# ── appinfo.vdf (Steam's binary app metadata) ───────────────────────────────
# Source of each game's real launch entries (executable + arguments) — the same
# config Steam itself uses. Binary keyvalues; v29 (magic 0x07564429) stores keys
# as indices into a string table. Best-effort: any failure falls back to the
# filename heuristic, so a profile is still created.

_APPINFO_MAGICS = (0x07564427, 0x07564428, 0x07564429)


class AppInfo:
    def __init__(self, path):
        with open(path, "rb") as f:
            self.d = f.read()
        self.strings = None
        self.magic, self.universe = struct.unpack_from("<II", self.d, 0)
        if self.magic not in _APPINFO_MAGICS:
            raise ValueError("unsupported appinfo.vdf magic 0x%08x" % self.magic)
        off = 8
        self.string_mode = self.magic == 0x07564429       # keys are string-table indices
        self.has_bin_checksum = self.magic in (0x07564428, 0x07564429)
        if self.string_mode:
            sto, = struct.unpack_from("<q", self.d, off); off += 8
            cnt, = struct.unpack_from("<I", self.d, sto)
            so = sto + 4
            strs = []
            for _ in range(cnt):
                e = self.d.index(b"\x00", so)
                strs.append(self.d[so:e].decode("utf-8", "replace")); so = e + 1
            self.strings = strs
        self.apps_off = off

    def _key(self, off):
        if self.string_mode:
            idx, = struct.unpack_from("<I", self.d, off)
            return (self.strings[idx] if idx < len(self.strings) else str(idx)), off + 4
        e = self.d.index(b"\x00", off)
        return self.d[off:e].decode("utf-8", "replace"), e + 1

    def _cstr(self, off):
        e = self.d.index(b"\x00", off)
        return self.d[off:e].decode("utf-8", "replace"), e + 1

    def _map(self, off):
        d = self.d
        m = {}
        while True:
            t = d[off]; off += 1
            if t in (0x08, 0x0B):                             # end / alternate end
                return m, off
            key, off = self._key(off)
            if t == 0x00:
                v, off = self._map(off)
            elif t == 0x01:
                v, off = self._cstr(off)
            elif t == 0x02:
                v, = struct.unpack_from("<i", d, off); off += 4
            elif t == 0x03:
                v, = struct.unpack_from("<f", d, off); off += 4
            elif t in (0x04, 0x06):                           # pointer / color
                v, = struct.unpack_from("<i", d, off); off += 4
            elif t == 0x07:
                v, = struct.unpack_from("<Q", d, off); off += 8
            elif t == 0x0A:
                v, = struct.unpack_from("<q", d, off); off += 8
            else:
                raise ValueError("unknown vdf type 0x%02x at %d" % (t, off - 1))
            m[key] = v

    def iter_apps(self):
        d = self.d
        off = self.apps_off
        hdr = 4 + 4 + 8 + 20 + 4 + (20 if self.has_bin_checksum else 0)
        while off + 8 <= len(d):
            appid, size = struct.unpack_from("<II", d, off)
            if appid == 0:
                break
            body = off + 8
            yield appid, body + hdr, body + size
            off = body + size

    def app(self, appid):
        for aid, vdf_off, _end in self.iter_apps():
            if aid == appid:
                try:
                    m, _ = self._map(vdf_off)
                except Exception:
                    return None
                return m.get("appinfo", m)
        return None


def find_appinfo(steam_dir=None):
    if steam_dir is None:
        steam_dir = find_steam_install()
    if not steam_dir:
        return None
    p = os.path.join(steam_dir, "appcache", "appinfo.vdf")
    if not os.path.isfile(p):
        return None
    try:
        return AppInfo(p)
    except Exception as e:
        warn(f"could not read appinfo.vdf: {e}")
        return None


def launch_options(app_meta):
    """Normalized launch entries from an appinfo app dict, in Steam's order."""
    out = []
    if not isinstance(app_meta, dict):
        return out
    cfg = app_meta.get("config", {})
    launch = cfg.get("launch", {}) if isinstance(cfg, dict) else {}
    if not isinstance(launch, dict):
        return out
    for k in sorted(launch, key=lambda x: int(x) if str(x).isdigit() else 1_000_000):
        e = launch[k]
        if not isinstance(e, dict):
            continue
        ec = e.get("config", {})
        ec = ec if isinstance(ec, dict) else {}
        out.append({
            "index": str(k),
            "executable": e.get("executable") or "",
            "arguments": e.get("arguments") or "",
            "workingdir": e.get("workingdir") or "",
            "type": e.get("type") or "",
            "oslist": ec.get("oslist") or "",
            "osarch": ec.get("osarch") or "",
            "betakey": ec.get("betakey") or "",
        })
    return out


def rank_windows_launches(options):
    """Windows-playable launch entries, best first; Steam's order breaks ties."""
    def is_win(o):
        return (not o["oslist"]) or ("windows" in o["oslist"].lower())
    cand = [o for o in options if is_win(o) and o["executable"]]
    if not cand:
        cand = [o for o in options if o["executable"]]

    def score(o):
        t = o["type"].lower()
        s = 0
        if t == "default":
            s += 3
        elif t in ("", "none", "game"):
            s += 2
        elif t in ("config", "server", "editor", "tool"):
            s -= 5
        if t == "vr":           # prefer a flat-screen launch by default
            s -= 1
        if o["betakey"]:
            s -= 3
        if o["osarch"] == "64":
            s += 1
        return s

    order = sorted(range(len(cand)), key=lambda i: (-score(cand[i]), i))
    return [cand[i] for i in order]


def _exe_key(path):
    return re.sub(r"/+", "/", (path or "").replace("\\", "/")).strip("/").lower()


def steam_args_for(entries, executable):
    """Distinct non-empty argument strings Steam offers for this exe, in Steam's order.
    Informational only: the loader never bakes them into a profile."""
    key = _exe_key(executable)
    out = []
    for e in entries:
        args = (e.get("arguments") or "").strip()
        if args and _exe_key(e.get("executable")) == key and args not in out:
            out.append(args)
    return out


def resolve_ci(base, rel, want_dir=False):
    """Resolve rel (may use \\ or /) under base, case-insensitively.
    Returns an existing file (or folder, with want_dir), else None."""
    rel = rel.replace("\\", "/")
    cur = base
    for part in [p for p in rel.split("/") if p and p != "."]:
        nxt = os.path.join(cur, part)
        if os.path.exists(nxt):
            cur = nxt
            continue
        try:
            entries = os.listdir(cur)
        except OSError:
            return None
        low = part.lower()
        match = next((e for e in entries if e.lower() == low), None)
        if match is None:
            return None
        cur = os.path.join(cur, match)
    found = os.path.isdir(cur) if want_dir else os.path.isfile(cur)
    return cur if found else None


def get_pe_arch(exe_path):
    """32 or 64 for an x86/x64 PE file; None otherwise, including for files that
    are unreadable or cut short (a stray tiny .exe used to crash the scan)."""
    try:
        with open(exe_path, "rb") as f:
            if f.read(2) != b"MZ":
                return None
            f.seek(0x3C)
            pe_offset = struct.unpack("<I", f.read(4))[0]
            f.seek(pe_offset)
            if f.read(4) != b"PE\x00\x00":
                return None
            machine = struct.unpack("<H", f.read(2))[0]
    except (OSError, struct.error):
        return None
    if machine == 0x14C:
        return 32
    if machine == 0x8664:
        return 64
    return None


def get_pe_imports(exe_path):
    imports = []
    try:
        with open(exe_path, "rb") as f:
            f.seek(0x3C)
            pe_offset = struct.unpack("<I", f.read(4))[0]
            f.seek(pe_offset + 4)
            coff = f.read(20)
            _, num_sections, _, _, _, size_opt, _ = struct.unpack("<HHIIIHH", coff)
            opt_start = pe_offset + 4 + 20
            f.seek(opt_start)
            pe_magic = struct.unpack("<H", f.read(2))[0]
            if pe_magic == 0x10B:
                import_offset = 104
            elif pe_magic == 0x20B:
                import_offset = 120
            else:
                return imports
            f.seek(opt_start + import_offset)
            import_rva, _ = struct.unpack("<II", f.read(8))
            if import_rva == 0:
                return imports
            sections_start = opt_start + size_opt
            sections = []
            for i in range(num_sections):
                f.seek(sections_start + i * 40)
                f.read(8)
                vsize, vaddr, rawsize, rawptr = struct.unpack("<IIII", f.read(16))
                sections.append((vaddr, rawsize, rawptr))

            # The descriptor table and the DLL names can sit in different sections.
            def rva_to_offset(rva):
                for vaddr, rawsize, rawptr in sections:
                    if vaddr <= rva < vaddr + rawsize:
                        return rawptr + (rva - vaddr)
                return None

            table = rva_to_offset(import_rva)
            if table is None:
                return imports
            for i in range(4096):                 # bound the walk on corrupt files
                f.seek(table + i * 20)
                entry = f.read(20)
                if len(entry) < 20:
                    break
                _, _, _, name_rva, _ = struct.unpack("<IIIII", entry)
                if name_rva == 0:
                    break
                name_offset = rva_to_offset(name_rva)
                if name_offset is None:
                    continue
                f.seek(name_offset)
                dll_name = f.read(256).split(b"\x00", 1)[0]
                imports.append(dll_name.decode("ascii", errors="replace"))
    except Exception:
        pass
    return imports


def find_game_exes(game_dir):
    skip_dirs = {
        "redist", "redistributables", "_redist", "__installer",
        "directx", "vcredist", "dotnet", ".net", "prerequisites",
        "support", "installscript", "_commonredist", "goldberg_loader",
    }
    exes = []
    for root, dirs, files in os.walk(game_dir):
        dirs[:] = [d for d in dirs if d.lower() not in skip_dirs and not d.startswith(".")]
        for f in files:
            if f.lower().endswith(".exe"):
                path = os.path.join(root, f)
                if os.path.isfile(path):
                    exes.append(path)
    return exes


def scan_game(game_dir):
    log(f"Scanning {game_dir}...")
    exes = find_game_exes(game_dir)
    if not exes:
        error("No .exe files found in game directory")
    results = []
    for exe in exes:
        name = os.path.basename(exe)
        arch = get_pe_arch(exe)
        imports = get_pe_imports(exe)
        has_steam = any("steam_api" in i.lower() for i in imports)
        size_mb = os.path.getsize(exe) / (1024 * 1024)
        results.append({
            "path": exe, "name": name, "arch": arch,
            "has_steam": has_steam, "imports": imports, "size_mb": size_mb,
        })
        rel = os.path.relpath(exe, game_dir)
        steam_str = "\033[1;32mimports steam_api\033[0m" if has_steam else "no steam_api"
        log(f"  {rel}: {arch}-bit, {steam_str}, {size_mb:.1f} MB")
    return results


def pick_main_exe(results, game_dir):
    scored = []
    for r in results:
        name_lower = os.path.splitext(r["name"])[0].lower()
        rel = os.path.relpath(r["path"], game_dir)
        depth = rel.count(os.sep)
        score = 0
        if any(pat in name_lower for pat in SKIP_EXE_PATTERNS):
            score -= 500
        rel_parts = set(p.lower() for p in rel.split(os.sep)[:-1])
        if rel_parts & SKIP_DIR_PATTERNS:
            score -= 400
        if r["has_steam"]:
            score += 200
        if r["size_mb"] >= 1.0:
            score += min(int(r["size_mb"]), 100)
        elif r["size_mb"] < 0.1:
            score -= 50
        if depth == 0:
            score += 30
        elif depth == 1:
            score += 20
        parent = os.path.basename(os.path.dirname(r["path"])).lower()
        if parent in ("bin", "binaries", "win64", "x64", "win32"):
            score += 40
        if "shipping" in name_lower or "game" in name_lower:
            score += 60
        if "64" in name_lower or "x64" in parent or "win64" in parent:
            score += 15
        scored.append((score, r))
    scored.sort(key=lambda x: x[0], reverse=True)
    if scored:
        best_score, best = scored[0]
        if best_score > 0:
            return best
    return results[0] if results else None


def find_steam_install():
    candidates = [
        os.path.expanduser("~/.steam/debian-installation"),
        os.path.expanduser("~/.steam/steam"),
        os.path.expanduser("~/.local/share/Steam"),
        os.path.expanduser("~/.steam/root"),
        "/usr/lib/steam",
    ]
    for d in candidates:
        if os.path.isfile(os.path.join(d, "steamclient.dll")):
            return d
    # fall back to any candidate that at least has a steamapps/ tree
    for d in candidates:
        if os.path.isdir(os.path.join(d, "steamapps")):
            return d
    return None


def find_steam_client_dlls():
    steam_dir = find_steam_install()
    if not steam_dir:
        return None
    dlls = {}
    sc32 = os.path.join(steam_dir, "steamclient.dll")
    if os.path.isfile(sc32):
        dlls["x86"] = {"dll": sc32}
    sc64 = os.path.join(steam_dir, "steamclient64.dll")
    if os.path.isfile(sc64):
        dlls["x86_64"] = {"dll": sc64}
    so_search = [
        ("x86", [
            os.path.join(steam_dir, "ubuntu12_32", "steamclient.so"),
            os.path.join(steam_dir, "linux32", "steamclient.so"),
            os.path.join(steam_dir, "steamrt32", "steamclient.so"),
        ]),
        ("x86_64", [
            os.path.join(steam_dir, "linux64", "steamclient.so"),
            os.path.join(steam_dir, "steamrt64", "steamclient.so"),
        ]),
    ]
    for arch_key, candidates in so_search:
        for so_path in candidates:
            if os.path.isfile(so_path):
                dlls.setdefault(arch_key, {})["so"] = so_path
                break
    if not dlls:
        return None
    dlls["_steam_dir"] = steam_dir
    return dlls


def detect_appid(game_dir, apps=None):
    """Resolve the real appid (and name) from the Steam library manifest.

    This confirms the game is actually installed in your library before a
    profile is made; the appid is delivered to the game via the SteamAppId
    environment variable that the loader sets.
    """
    return resolve_appid_from_library(game_dir, apps=apps)


def get_loader_exe(arch):
    if arch == 32:
        exe = os.path.join(LOADER_SRC, "mythix_loader_32.exe")
    else:
        exe = os.path.join(LOADER_SRC, "mythix_loader.exe")
    if os.path.isfile(exe):
        return exe
    any_exe = os.path.join(LOADER_SRC, "mythix_loader.exe")
    if os.path.isfile(any_exe):
        return any_exe
    return None


def find_compatdata(appid, steam_dir=None):
    """Steam's Proton prefix for this app (<library>/steamapps/compatdata/<appid>), if any."""
    appid = str(appid or "")
    if not appid.isdigit() or appid == "0":
        return None
    if steam_dir is None:
        steam_dir = find_steam_install()
    if not steam_dir:
        return None
    for lib in steam_libraries(steam_dir):
        cd = os.path.join(lib, "steamapps", "compatdata", appid)
        if os.path.isdir(os.path.join(cd, "pfx")):
            return cd
    return None


# Keys older profiles had that the loader no longer reads; dropped on refresh.
RETIRED_INI_KEYS = {"steamclientdll", "steamclient64dll", "steamclientso",
                    "steamclient64so", "forcearch", "noinject"}


def read_profile_ini(path):
    """[MythixLoader] keys of an existing profile ini, as {lowercase: (Key, raw value)}.
    Missing or unreadable file: {}."""
    out = {}
    try:
        with open(path, "rb") as f:
            raw = f.read()
    except OSError:
        return out
    if raw.startswith(b"\xff\xfe"):
        text = raw[2:].decode("utf-16-le", "replace")
    else:
        text = raw.decode("utf-8-sig", "replace")
    in_section = False
    for line in text.splitlines():
        line = line.strip()
        if not line or line[0] in "#;":
            continue
        if line.startswith("["):
            in_section = line.lower() == "[mythixloader]"
            continue
        if in_section and "=" in line:
            name, value = line.split("=", 1)
            name = name.strip()
            if name:
                out[name.lower()] = (name, value.strip())
    return out


def create_profile(game_dir, appid=None, target_exe=None, profile_name=None, dry_run=False,
                   require_appid=False):
    """Plan (and, unless dry_run, write) a loader profile. Returns the plan dict.
    With require_appid, a game whose appid can't be found is an error and
    nothing is written (instead of a profile with AppId=0)."""
    if not JSON_MODE:
        print(BANNER)

    # Discover the Steam library once and reuse it for appid resolution.
    apps = installed_apps()

    results = scan_game(game_dir)
    print()

    # Resolve the appid + matching library entry first — it drives the launch
    # target below and confirms the game is actually in your library.
    game_name = None
    matched = None
    if not appid:
        appid, game_name = detect_appid(game_dir, apps=apps)
    if appid and appid != "0":
        matched = next((a for a in apps if a["appid"] == appid), None)
        if matched and not game_name:
            game_name = matched["name"]

    # Decide the launch target: --exe wins; else the exe from Steam's own launch
    # config; else the filename-scoring heuristic. Steam's per-entry *arguments*
    # (-dx12 / -dx11 / safe mode...) are choices, so none gets baked in — the
    # game's own settings and the launcher's per-game launch args decide.
    main_exe = None
    launch_args = ""
    launch_source = "heuristic"
    steam_options = []
    inst_dir = matched["installdir"] if (matched and matched["installdir"]) else game_dir
    entries = []
    if appid and appid.isdigit():
        ai = find_appinfo()
        entries = launch_options(ai.app(int(appid)) if ai else None)
    ranked = rank_windows_launches(entries)

    if target_exe:
        # A relative --exe is looked up under the game dir first, then the cwd.
        wanted = [target_exe] if os.path.isabs(target_exe) else [os.path.join(game_dir, target_exe), target_exe]
        wanted = {os.path.realpath(p) for p in wanted}
        match = next((r for r in results if os.path.realpath(r["path"]) in wanted), None)
        if not match:
            match = next((r for r in results if r["name"].lower() == os.path.basename(target_exe).lower()), None)
        if match:
            main_exe = match
            launch_source = "manual"
        else:
            error(f"Specified exe not found: {target_exe}")
    else:
        for opt in ranked:
            cand = resolve_ci(inst_dir, opt["executable"])
            if cand:
                main_exe = {
                    "path": cand,
                    "name": os.path.basename(cand),
                    "arch": get_pe_arch(cand),
                    "has_steam": False,
                    "size_mb": os.path.getsize(cand) / (1024 * 1024),
                }
                launch_source = "appinfo"
                log(f"Launch target from Steam app config: {opt['executable']}")
                break
        if main_exe is None:
            main_exe = pick_main_exe(results, game_dir)
    if not main_exe:
        error("Could not identify a game executable")

    # Steam's own launch entry for the chosen exe (however it was chosen) gives
    # the working directory, and its argument variants are listed for reference.
    exe_real = os.path.realpath(main_exe["path"])
    exe_entry = None
    for opt in ranked:
        cand = resolve_ci(inst_dir, opt["executable"])
        if cand and os.path.realpath(cand) == exe_real:
            exe_entry = opt
            break
    # The game runs in Steam's workingdir for the entry if it sets one, else in
    # the exe's own folder — never in the profile dir, so games that load files
    # relative to their working directory find them.
    run_dir = os.path.dirname(main_exe["path"])
    if exe_entry:
        steam_options = steam_args_for(entries, exe_entry["executable"])
        if steam_options:
            log(f"  Steam's launch options for it: {' | '.join(steam_options)}")
            log("  (not applied — add one to the game's launch args if you want it)")
        if exe_entry["workingdir"]:
            wd = resolve_ci(inst_dir, exe_entry["workingdir"], want_dir=True)
            if wd:
                run_dir = wd
            else:
                warn(f"Steam's working dir '{exe_entry['workingdir']}' not found — using the exe's folder")

    try:
        rel = os.path.relpath(main_exe["path"], game_dir)
        if rel.startswith(".."):
            rel = main_exe["path"]
    except ValueError:
        rel = main_exe["path"]
    log(f"Main exe: {rel}")
    log(f"Run dir:  {run_dir}")
    arch = main_exe["arch"] or 64
    print()

    if appid and appid != "0":
        log(f"Steam library match: {game_name or '?'} (appid {appid})")
    else:
        if require_appid:
            error("Couldn't find this game's Steam appid — pass --appid")
        warn("Game not found in your Steam library — launching needs an owned,")
        warn("installed title. Set --appid manually if you know it.")
        appid = "0"
    print()

    # Loader exe
    log("--- Step 1: Mythix Loader ---")
    loader_exe = get_loader_exe(arch)
    if not loader_exe:
        error(f"mythix_loader.exe not found at {LOADER_SRC}\n  Build it: cd {LOADER_SRC}/src && make")
    log(f"  Loader ({arch}-bit): {loader_exe}")
    print()

    # Steam client DLLs
    log("--- Step 2: Steam install ---")
    dlls = find_steam_client_dlls()
    if not dlls:
        error("Could not find Steam client DLLs. Is Steam installed?")
    log(f"  Steam: {dlls['_steam_dir']}")
    print()

    # Profile name is always sanitized (also when given via --name) so the
    # profile dir can never land outside ~/.mythix/loader_profiles/. A title
    # with no ASCII letters (e.g. a Japanese name) falls back to the folder
    # name, then to the appid.
    if profile_name:
        profile_name = _slug(profile_name)
        if not profile_name:
            error("--name needs at least one of a-z, 0-9, - or _")
    else:
        profile_name = (_slug(game_name) or _slug(os.path.basename(os.path.normpath(game_dir)))
                        or (f"app-{appid}" if appid != "0" else ""))
        if not profile_name:
            error("Could not derive a profile name — pass --name")

    profile_dir = os.path.join(PROFILES_DIR, profile_name)
    stub_name = (_slug(os.path.splitext(main_exe["name"])[0]) or "game") + ".exe"

    plan = {
        "ok": True,
        "dry_run": bool(dry_run),
        "appid": appid,
        "name": game_name or os.path.basename(os.path.normpath(game_dir)),
        "game_dir": inst_dir,
        "exe": main_exe["path"],
        "run_dir": run_dir,
        "args": launch_args,
        "launch_options": steam_options,
        "arch": arch,
        "launch_source": launch_source,
        "profile_name": profile_name,
        "profile_dir": profile_dir,
        "stub_path": os.path.join(profile_dir, stub_name),
        "ini_path": os.path.join(profile_dir, "mythix_loader.ini"),
        "steam_prefix": find_compatdata(appid),
    }

    if dry_run:
        log(f"Dry run — would create profile '{profile_name}' at {profile_dir}")
        return plan

    os.makedirs(profile_dir, exist_ok=True)

    log(f"--- Step 3: Creating profile '{profile_name}' ---")

    # Files written by older versions of this script mean nothing to the real
    # steamclient — clear them so regenerated profiles come out clean.
    legacy_settings = os.path.join(profile_dir, "steam_settings")
    if os.path.isdir(legacy_settings) and not os.path.islink(legacy_settings):
        shutil.rmtree(legacy_settings, ignore_errors=True)
        log("  Removed legacy steam_settings/")
    legacy_appid = os.path.join(profile_dir, "steam_appid.txt")
    if os.path.isfile(legacy_appid):
        os.remove(legacy_appid)
        log("  Removed legacy steam_appid.txt")
    # Stubs before v1.2 copied the steamclient files into the profile root at every
    # launch (nothing used them). The stub no longer does — clear the leftovers.
    for leftover in ("steamclient.dll", "steamclient64.dll", "steamclient.so", "steamclient64.so"):
        p = os.path.join(profile_dir, leftover)
        if os.path.islink(p) or os.path.isfile(p):
            os.remove(p)
            log(f"  Removed leftover {leftover} from the profile root")
    # Before v1.3 every profile also carried its own steamclient copies in client/
    # (~100 MB, going stale with each Steam update). The game's steam_api loads the
    # running Steam's own steamclient, so drop them; anything else in client/ stays.
    # Symlinked dirs are left alone so nothing outside the profile is touched.
    removed = False
    client_dir = os.path.join(profile_dir, "client")
    if os.path.isdir(client_dir) and not os.path.islink(client_dir):
        for sub_dir, names in (("x86", ("steamclient.dll", "steamclient.so")),
                               ("x86_64", ("steamclient64.dll", "steamclient.so"))):
            d = os.path.join(client_dir, sub_dir)
            if not os.path.isdir(d) or os.path.islink(d):
                continue
            for n in names:
                p = os.path.join(d, n)
                if os.path.islink(p) or os.path.isfile(p):
                    os.remove(p)
                    removed = True
            if not os.listdir(d):
                os.rmdir(d)
        if not os.listdir(client_dir):
            os.rmdir(client_dir)
    if removed:
        log("  Removed old steamclient copies from client/")

    # Copy loader exe
    shutil.copy2(loader_exe, os.path.join(profile_dir, stub_name))
    log(f"  Stub: {stub_name}")

    # Generate mythix_loader.ini. Exe, ExeRunDir and AppId come from the game
    # every time; anything else set in an existing ini is kept.
    ini_path = os.path.join(profile_dir, "mythix_loader.ini")
    old = read_profile_ini(ini_path)
    kept = []

    def key(name, default):
        found = old.get(name.lower())
        if found is None:
            return f"{name}={default}"
        if found[1] != default:
            kept.append(name)
        return f"{name}={found[1]}"

    ini_lines = [
        f"# Mythix Loader profile — {profile_name}",
        "# Generated by mythix-loader. Re-running it on the game rewrites Exe,",
        "# ExeRunDir and AppId and keeps everything else set here. Values can use",
        "# %VARS% (e.g. %MYTHIX_GAME_DIR%, %MYTHIX_PROFILE_DIR%, %SteamAppId%);",
        "# relative paths are relative to this folder.",
        "[MythixLoader]",
        f"Exe={main_exe['path']}",
        "# Working directory for the game: Steam's for this exe, else the exe's folder.",
        f"ExeRunDir={run_dir}",
        "# Arguments always passed to the game. Arguments given to the loader itself",
        "# (e.g. per-game launch args from the Mythix launcher) are added after these.",
        key("ExeCommandLine", launch_args),
    ]
    if steam_options:
        ini_lines.append(f"# Steam's launch options for this exe: {' | '.join(steam_options)}")
    ini_lines += [
        f"AppId={appid}",
        "",
        "# Extra environment variables for the game: KEY=VAL;KEY2=VAL2, -KEY removes one.",
        key("EnvVars", ""),
        "",
        "# Wait for game to exit before the loader exits (returns the exe's exit code)",
        key("Persist", "1"),
        "# ...including processes the game starts, e.g. when the exe is a launcher",
        "# that starts the real game and exits. 0 = wait for the exe only. Keep 1",
        "# under neutron: a direct launch kills what's left 30 s after the stub exits.",
        key("WaitForChildren", "1"),
        "# Don't start a second copy while this profile's game is still running: a",
        "# second launch waits for the running one instead (needs Persist=1).",
        key("SingleInstance", "1"),
        "",
        "# CPU priority: idle, belownormal, normal, abovenormal or high.",
        key("Priority", ""),
        "# CPU cores the game may use, e.g. 0 or 0,2-3 (helps old games that glitch",
        "# on many cores). The processes it starts get the same cores.",
        key("Affinity", ""),
        "",
        "# Commands run before the game starts and after it exits (RunAfter needs",
        "# Persist=1). The loader waits for each; use: cmd /c start \"\" x.exe to not wait.",
        key("RunBefore", ""),
        key("RunAfter", ""),
        "",
        "# The loader's log, also written here (overwritten each launch); empty = none.",
        key("LogFile", "mythix_loader.log"),
        "# More detail in the log",
        key("Debug", "0"),
        "",
        "# DLLs loaded into the loader process itself, NOT into the game, so they",
        "# don't change how the game runs. Only for troubleshooting the loader",
        "# (e.g. checking a DLL loads in this prefix). Semicolon-separated.",
        key("ExtraDlls", ""),
    ]
    known = {"exe", "exerundir", "appid", "execommandline", "envvars", "persist",
             "waitforchildren", "singleinstance", "priority", "affinity", "runbefore",
             "runafter", "logfile", "debug", "extradlls"} | RETIRED_INI_KEYS
    extra = [f"{name}={value}" for low, (name, value) in old.items() if low not in known]
    if extra:
        ini_lines += ["", "# Kept from the previous ini (this loader version doesn't use them)"] + extra
    if kept:
        log(f"  Kept your settings: {', '.join(kept)}")
    with open(ini_path, "w", encoding="utf-8") as f:   # the loader reads UTF-8
        f.write("\n".join(ini_lines) + "\n")
    plan["kept_settings"] = kept

    print()
    stub_path = os.path.join(profile_dir, stub_name)

    print("\033[1;36m" + "=" * 60 + "\033[0m")
    print("\033[1;36m  MYTHIX LOADER PROFILE CREATED\033[0m")
    print("\033[1;36m" + "=" * 60 + "\033[0m")
    print()
    log(f"Game:       {game_name or os.path.basename(os.path.normpath(game_dir))}")
    log(f"AppID:      {appid}")
    log(f"Arch:       {arch}-bit")
    log(f"Main exe:   {main_exe['name']}")
    log(f"Run dir:    {run_dir}")
    if steam_options:
        log(f"Steam opts: {' | '.join(steam_options)}  (not baked in — pass one as a launch arg)")
    log(f"Profile:    {profile_dir}")
    log(f"Stub:       {stub_name}")
    print()
    log(f"Config:     {ini_path}")
    log(f"  Edit the ini to add extra DLLs, env vars, or tweak settings.")
    print()
    log("To launch by hand (the Steam client must be running; SteamAppId makes")
    log("neutron go through its steam.exe shim, which connects the game to Steam):")
    log(f"  SteamAppId={appid} <compat_tool>/neutron waitforexitandrun \"{stub_path}\" [game args...]")
    print()
    return plan


def list_games(show_tools=False):
    print(BANNER)
    steam_dir = find_steam_install()
    if not steam_dir:
        error("Could not find a Steam installation.")
    log(f"Steam: {steam_dir}")
    libs = steam_libraries(steam_dir)
    log(f"{len(libs)} librar{'y' if len(libs) == 1 else 'ies'}:")
    for lib in libs:
        marker = "" if os.path.isdir(os.path.join(lib, "steamapps")) else "  \033[1;33m(missing)\033[0m"
        log(f"    {lib}{marker}")
    print()

    apps = installed_apps(steam_dir)
    games = [a for a in apps if show_tools or not is_tool_app(a)]
    hidden = len(apps) - len(games)
    if not games:
        log("No installed titles found.")
        return

    suffix = f"  ({hidden} tool/runtime hidden — use --all)" if hidden and not show_tools else ""
    log(f"{len(games)} installed title(s){suffix}:\n")
    for a in games:
        present = os.path.isdir(a["installdir"]) if a["installdir"] else False
        mark = "\033[1;32m*\033[0m" if present else "\033[1;33m?\033[0m"
        log(f"  {mark} [{a['appid']:>8}]  {a['name']}")
        log(f"             {a['installdir']}")
    print()
    log("Create a loader profile for one with:")
    log("  mythix-loader \"<install dir path above>\"")
    print()


