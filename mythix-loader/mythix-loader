def _default_loader_dir():
    """Where the loader exes live: $MYTHIX_LOADER_DIR, else next to this script
    (the repo copy or the launcher-managed copy), else ~/.mythix/mythix-loader."""
    env = os.environ.get("MYTHIX_LOADER_DIR")
    if env:
        return os.path.abspath(os.path.expanduser(env))
    if os.path.isfile(os.path.join(SCRIPT_DIR, "mythix_loader.exe")):
        return SCRIPT_DIR
    return os.path.join(MYTHIX_DIR, "mythix-loader")


