def list_profiles():
    print(BANNER)
    if not os.path.isdir(PROFILES_DIR):
        log("No loader profiles yet.")
        return

    profiles = sorted(d for d in os.listdir(PROFILES_DIR)
                      if os.path.isdir(os.path.join(PROFILES_DIR, d)))
    if not profiles:
        log("No loader profiles yet.")
        return

    log(f"{len(profiles)} profile(s) in {PROFILES_DIR}:\n")
    for p in profiles:
        pdir = os.path.join(PROFILES_DIR, p)
        ini = os.path.join(pdir, "mythix_loader.ini")
        appid = "?"
        exe_name = "?"
        if os.path.isfile(ini):
            with open(ini, encoding="utf-8", errors="replace") as f:
                for line in f:
                    s = line.strip()
                    if s.startswith("Exe="):
                        exe_name = os.path.basename(s.split("=", 1)[1])
                    elif s.startswith("AppId="):
                        appid = s.split("=", 1)[1] or "?"
        stubs = [f for f in os.listdir(pdir) if f.endswith(".exe")]
        stub = stubs[0] if stubs else "?"
        log(f"  {p}/")
        log(f"    AppID: {appid}  |  Exe: {exe_name}  |  Stub: {stub}")


def show_launch_info(appid):
    print(BANNER)
    appid = str(appid).strip()
    ai = find_appinfo()
    if not ai:
        error("Could not read appinfo.vdf (is Steam installed?)")
    app_meta = ai.app(int(appid)) if appid.isdigit() else None
    if not app_meta:
        error(f"appid {appid} not found in appinfo.vdf")
    common = app_meta.get("common", {})
    name = common.get("name", "?") if isinstance(common, dict) else "?"
    atype = common.get("type", "?") if isinstance(common, dict) else "?"
    log(f"{name}  (appid {appid}, type {atype})")
    opts = launch_options(app_meta)
    if not opts:
        log("No launch entries.")
        return
    ranked = rank_windows_launches(opts)
    best = ranked[0] if ranked else None
    print()
    log(f"{len(opts)} launch entr{'y' if len(opts) == 1 else 'ies'} (Steam order):")
    for o in opts:
        bits = []
        if o["arguments"]:
            bits.append(f"args={o['arguments']}")
        if o["oslist"]:
            bits.append(f"os={o['oslist']}")
        if o["osarch"]:
            bits.append(f"arch={o['osarch']}")
        if o["type"]:
            bits.append(f"type={o['type']}")
        if o["betakey"]:
            bits.append(f"beta={o['betakey']}")
        tail = ("  " + "  ".join(bits)) if bits else ""
        star = "  \033[1;32m<- default pick\033[0m" if (best is not None and o is best) else ""
        log(f"  [{o['index']}] {o['executable']}{tail}{star}")
    print()
    log("Profiles use the picked entry's exe. Its arguments aren't baked in —")
    log("set the ones you want as the game's launch args.")
    print()


def main():
    parser = argparse.ArgumentParser(
        description="mythix-loader — steamclient loader profile manager",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
    mythix-loader /path/to/game --appid 12345       # Create loader profile
    mythix-loader /path/to/game --exe game.exe      # Target specific exe
    mythix-loader --games                            # List installed games
    mythix-loader --games --all                      # ...including tools/runtimes
    mythix-loader --launch-info 1091500              # Show Steam launch entries
    mythix-loader /path/to/game --dry-run            # Plan a profile, write nothing
    mythix-loader /path/to/game --json               # Machine-readable (used by the launcher)
    mythix-loader --list                             # List profiles
    mythix-loader --setup                            # Check setup
        """,
    )
    parser.add_argument("game_dir", nargs="?", help="Path to game directory")
    parser.add_argument("--appid", help="Steam appid")
    parser.add_argument("--exe", dest="target_exe", help="Target specific game exe")
    parser.add_argument("--name", dest="profile_name", help="Profile name (auto-generated if omitted)")
    parser.add_argument("--games", "--scan-library", action="store_true", dest="games",
                        help="List installed games from your Steam library")
    parser.add_argument("--all", action="store_true", help="With --games, also show tools/runtimes")
    parser.add_argument("--launch-info", dest="launch_info", metavar="APPID",
                        help="Show the Steam launch entries for an appid (and the default pick)")
    parser.add_argument("--list", action="store_true", help="List existing profiles")
    parser.add_argument("--setup", action="store_true", help="Check setup")
    parser.add_argument("--json", action="store_true",
                        help="Print one JSON result object to stdout (human output goes to stderr)")
    parser.add_argument("--dry-run", action="store_true",
                        help="Plan the profile (appid, launch target, paths) without writing anything")
    parser.add_argument("--require-appid", action="store_true",
                        help="Fail without writing anything if the appid can't be found")
    parser.add_argument("--loader-dir", metavar="DIR",
                        help="Directory holding mythix_loader.exe / mythix_loader_32.exe")
    args = parser.parse_args()

    global JSON_MODE, LOADER_SRC
    JSON_MODE = args.json
    if args.loader_dir:
        LOADER_SRC = os.path.abspath(os.path.expanduser(args.loader_dir))

    if args.setup:
        setup()
        return
    if args.games:
        list_games(show_tools=args.all)
        return
    if args.launch_info:
        show_launch_info(args.launch_info)
        return
    if args.list:
        list_profiles()
        return
    if not args.game_dir:
        parser.print_help()
        return

    game_dir = os.path.abspath(args.game_dir)
    if not os.path.isdir(game_dir):
        error(f"Not a directory: {game_dir}")
    if args.appid is not None:
        args.appid = args.appid.strip()
        if not args.appid.isdigit():
            error(f"--appid must be a number, got '{args.appid}'")

    if JSON_MODE:
        # Human-readable output goes to stderr; stdout carries only the result.
        sys.stdout = sys.stderr
        try:
            plan = create_profile(game_dir, appid=args.appid, target_exe=args.target_exe,
                                  profile_name=args.profile_name, dry_run=args.dry_run,
                                  require_appid=args.require_appid)
        except SystemExit:
            raise
        except Exception as e:  # never leave the launcher without a JSON answer
            error(f"{type(e).__name__}: {e}")
        finally:
            sys.stdout = _REAL_STDOUT
        _REAL_STDOUT.write(json.dumps(plan) + "\n")
        _REAL_STDOUT.flush()
        return

    plan = create_profile(game_dir, appid=args.appid, target_exe=args.target_exe,
                          profile_name=args.profile_name, dry_run=args.dry_run,
                          require_appid=args.require_appid)
    if args.dry_run:
        print()
        log("Dry run — nothing was written:")
        for key in ("name", "appid", "exe", "run_dir", "launch_options", "launch_source",
                    "profile_dir", "stub_path", "steam_prefix"):
            log(f"  {key:<13} {plan.get(key)}")
        print()


if __name__ == "__main__":
    main()
